<UserControl x:Class="Ecoinv.Forms.UserControlPages.ClientsDetailUCPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
             mc:Ignorable="d"
             x:Name="ThisUC"
             d:DataContext="{d:DesignInstance Type=dataContext:CLIENTSDataContext}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary Source="/Components/Converters.xaml"></ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="#FF64CCF1" BorderThickness="1" CornerRadius="3" Padding="10" Background="AntiqueWhite">
        <StackPanel>
            <Label Content="Ügyfél adatai" FontWeight="Bold" FontSize="14" Foreground="#2A4B7C" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Ügyfél azonosító:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Width="50" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding ID, Mode=OneWay}" IsEnabled="False"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Név:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="250" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding NAME, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Típus:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="5,2,0,5"
                          ItemsSource="{Binding DataContext.ClientTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="TYPE_NAME"
                          SelectedValuePath="TYPE_NAME" 
                          SelectedValue="{Binding CLIENT_TYPE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Adószám:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding TAX_NUMBER, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Telefonszám:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding PHONE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="5" Grid.Column="0" Content="E-mail cím:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Width="250" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding EMAIL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Bankszámlaszám:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" Width="250" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding BANKACCOUNT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="7" Grid.Column="0" Content="Közösségi adószám:" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Row="7" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="5,2,0,5" Text="{Binding COMTAX_NUMBER, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Aktív kliens (CACTIVE):" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,2,0,5" 
                          IsChecked="{Binding CACTIVE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource in2bool}}"/>

                <Label Grid.Row="9" Grid.Column="0" Content="Belső megjegyzés:" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <TextBox Grid.Row="9" Grid.Column="1" Width="400" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" Margin="5,2,0,5" 
                         Text="{Binding INTERNAL_NOTE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>