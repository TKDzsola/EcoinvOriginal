<Window x:Class="Ecoinv.Forms.CREATEINVOICEFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        mc:Ignorable="d"
        Title="Számla kiállítása"
        Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.DataContext>
        <dataContext:CreateInvoiceDataContext/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Components/RoundedButton.xaml"/>
                <ResourceDictionary Source="../Components/ShadowLabel.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <DropShadowEffect x:Key="CardShadow" Color="#20000000" BlurRadius="10" ShadowDepth="2"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="Vevő kiválasztása:" FontWeight="Bold" Foreground="#4B5563"/>
                    <DockPanel>
                        <Button Content="🔍 Keresés" 
                                Command="{Binding CommandMenuCLIENTSClick}"
                                Width="80" DockPanel.Dock="Right" Margin="5,0,0,0"
                                Style="{DynamicResource RoundedButtonStyle}"/>

                        <TextBox Text="{Binding SelectedClientName}" 
                                 IsReadOnly="True" 
                                 Padding="5" Background="#F9FAFB" BorderBrush="#D1D5DB"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Label Content="Számla sorszáma:" FontWeight="Bold" Foreground="#4B5563"/>
                    <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" BorderBrush="#D1D5DB"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                CornerRadius="8" Padding="15" Margin="0,0,0,15"
                Visibility="{Binding IsAddItemPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <Label Content="Szolgáltatás:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Services}" 
                              SelectedItem="{Binding SelectedService}"
                              DisplayMemberPath="NAME"
                              Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <Label Content="Mennyiség:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EditQty, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <Label Content="Nettó egységár:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding EditNetUnitPrice, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5">
                    <Label Content="ÁFA kulcs:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding VatRates}" 
                              SelectedItem="{Binding SelectedVatRate}"
                              DisplayMemberPath="NAME"
                              Padding="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">

            <Button Content="{Binding PrimaryButtonText}" 
                    Command="{Binding CommandPrimaryAction}"
                    Width="140" Height="35" Margin="0,0,10,0"
                    Style="{DynamicResource RoundedButtonStyle}"
                    Background="#10B981" Foreground="White" FontWeight="Bold"/>

            <Button Content="{Binding SecondaryButtonText}" 
                    Command="{Binding CommandSecondaryAction}"
                    Width="140" Height="35"
                    Style="{DynamicResource RoundedButtonStyle}"
                    Background="#EF4444" Foreground="White"/>

        </StackPanel>

        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding InvoiceDetails}" 
                  SelectedItem="{Binding SelectedInvoiceDetail}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White" BorderBrush="#E5E7EB" RowHeight="30">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Megnevezés" Binding="{Binding SERVICE_NAME}" Width="3*"/>
                <DataGridTextColumn Header="Menny." Binding="{Binding QTY}" Width="0.8*"/>
                <DataGridTextColumn Header="Nettó ár" Binding="{Binding NET_UNIT_PRICE, StringFormat={}{0:N2}}" Width="1*"/>
                <DataGridTextColumn Header="ÁFA %" Binding="{Binding VAT_PERCENT}" Width="0.8*"/>
                <DataGridTextColumn Header="Nettó érték" Binding="{Binding LINE_TOTAL_NET, StringFormat={}{0:N2}}" Width="1.2*"/>
                <DataGridTextColumn Header="Bruttó érték" Binding="{Binding LINE_TOTAL_GROSS, StringFormat={}{0:N2}}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15" Margin="0,15,0,0" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Content="💾 Számla mentése &amp; PDF" 
                            Command="{Binding CommandSaveInvoice}"
                            Width="200" Height="40" Margin="0,0,15,0"
                            FontSize="14" FontWeight="Bold"
                            Style="{DynamicResource RoundedButtonStyle}"/>

                    <Button Content="Mégse" 
                            Command="{Binding CommandCancelInvoice}"
                            Width="100" Height="40"
                            Style="{DynamicResource RoundedButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="15,0">
                        <TextBlock Text="Nettó összesen:" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding TotalNet, StringFormat={}{0:N2} Ft}" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="15,0">
                        <TextBlock Text="ÁFA tartalom:" Foreground="Gray" FontSize="12"/>
                        <TextBlock Text="{Binding TotalVat, StringFormat={}{0:N2} Ft}" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <Border Background="#ECFDF5" CornerRadius="5" Padding="10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fizetendő:" Foreground="#059669" FontSize="12"/>
                            <TextBlock Text="{Binding TotalGross, StringFormat={}{0:N2} Ft}" FontSize="20" FontWeight="ExtraBold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>