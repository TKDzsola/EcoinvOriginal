<Window x:Class="Ecoinv.Forms.SEARCHINVOICEFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        Title="Számla keresése"
        Height="700"
        Width="1100"
        Background="#F9FAFB"
        WindowStartupLocation="CenterScreen">

    <!-- ====================== DATACONTEXT ====================== -->
    <Window.DataContext>
        <dataContext:SEARCHINVOICEDataContext />
    </Window.DataContext>

    <!-- ====================== RESOURCES ====================== -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Külső stílusfájlok -->
                <ResourceDictionary Source="../Components/RoundedButton.xaml"/>
                <ResourceDictionary Source="../Components/ShadowLabel.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- Converter -->
            <components:StatusToTextConverter x:Key="StatusToTextConverter"/>

            <!-- Árnyék -->
            <DropShadowEffect x:Key="CardShadow"
                              Color="#33000000"
                              BlurRadius="10"
                              ShadowDepth="3"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ====================== LAYOUT ====================== -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BAL OLDALI PANEL -->
        <Border Background="White"
                CornerRadius="12"
                Padding="25"
                Effect="{StaticResource CardShadow}"
                Margin="0 0 20 0">

            <StackPanel>

                <TextBlock Text="Számla keresése"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Margin="0 0 0 20"/>

                <!-- Ügyfél neve -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Ügyfél neve"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>
                    <TextBox Height="36"
                             Padding="8"
                             Background="#F3F4F6"
                             BorderBrush="#D1D5DB"
                             Text="{Binding SearchClientName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Számlaszám -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Számlaszám"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>
                    <TextBox Height="36"
                             Padding="8"
                             Background="#F3F4F6"
                             BorderBrush="#D1D5DB"
                             Text="{Binding SearchInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Dátum intervallum -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Dátum intervallum"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>

                    <StackPanel Orientation="Horizontal">
                        <DatePicker Width="140"
                                    SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" - "
                                   VerticalAlignment="Center"
                                   Margin="10 0"/>
                        <DatePicker Width="140"
                                    SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Státusz -->
                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Státusz"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>

                    <ComboBox Height="36"
                              Padding="5"
                              Background="#F3F4F6"
                              BorderBrush="#D1D5DB"
                              ItemsSource="{Binding StatusList}"
                              SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Text"
                              SelectedValuePath="Code"/>
                </StackPanel>

                <!-- KERESÉS GOMB -->
                <Button Content="Keresés"
                        Height="44"
                        Cursor="Hand"
                        Command="{Binding CommandSearch}"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Margin="0 20 0 0"/>
            </StackPanel>
        </Border>


        <!-- JOBB OLDALI PANEL -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Effect="{StaticResource CardShadow}">

            <DockPanel LastChildFill="True">

                <!-- GOMBOK -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 20 0 0">

                    <Button Content="Megtekintés"
                            Width="140"
                            Height="40"
                            Margin="5"
                            Command="{Binding CommandOpen}"
                            Style="{DynamicResource RoundedButtonStyle}"/>

                    <Button Content="Nyomtatás / PDF"
                            Width="150"
                            Height="40"
                            Margin="5"
                            Command="{Binding CommandPrint}"
                            Style="{DynamicResource RoundedButtonStyle}"/>

                    <Button Content="Sztornó"
                            Width="120"
                            Height="40"
                            Background="#DC2626"
                            Foreground="White"
                            Margin="5"
                            Command="{Binding CommandStorno}"
                            Style="{DynamicResource RoundedButtonStyle}"/>
                </StackPanel>


                <!-- DATAGRID -->
                <Border Background="#F9FAFB"
                        CornerRadius="10"
                        Padding="10">

                    <DataGrid ItemsSource="{Binding INVOICE_HEADERSList}"
                              SelectedItem="{Binding SelectedINVOICE_HEADERS}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E5E7EB">

                        <DataGrid.Columns>
                            <!-- Számlaszám -->
                            <DataGridTextColumn Header="Számlaszám"
                                                Binding="{Binding INVOICE_NUMBER}"
                                                Width="150"/>

                            <!-- Dátum -->
                            <DataGridTextColumn Header="Kelt"
                                                Binding="{Binding ISSUE_DATE, StringFormat=\{0:yyyy.MM.dd\}}"
                                                Width="120"/>

                            <!-- Vevő -->
                            <DataGridTextColumn Header="Vevő"
                                                Binding="{Binding CLIENT_NAME}"
                                                Width="200"/>

                            <!-- Státusz -->
                            <DataGridTextColumn Header="Státusz"
                                                Binding="{Binding SZLASTAT, Converter={StaticResource StatusToTextConverter}}"
                                                Width="160"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Border>

            </DockPanel>

        </Border>
    </Grid>

</Window>
