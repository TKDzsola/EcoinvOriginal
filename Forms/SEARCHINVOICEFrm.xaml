<Window x:Class="Ecoinv.Forms.SEARCHINVOICEFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        Title="Számla keresése"
        Height="700"
        Width="1100"
        Background="#F9FAFB"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <dataContext:SEARCHINVOICEDataContext />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Components/RoundedButton.xaml"/>
                <ResourceDictionary Source="../Components/ShadowLabel.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <components:StatusToTextConverter x:Key="StatusToTextConverter"/>

            <DropShadowEffect x:Key="CardShadow"
                              Color="#33000000"
                              BlurRadius="10"
                              ShadowDepth="3"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" 
                Background="White"
                CornerRadius="12"
                Padding="25"
                Effect="{StaticResource CardShadow}"
                Margin="0 0 20 0">

            <StackPanel>
                <TextBlock Text="Számla keresése"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           Margin="0 0 0 20"/>

                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Ügyfél neve"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>
                    <TextBox Height="36"
                             Padding="8"
                             Background="#F3F4F6"
                             BorderBrush="#D1D5DB"
                             Text="{Binding SearchClientName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Számlaszám"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>
                    <TextBox Height="36"
                             Padding="8"
                             Background="#F3F4F6"
                             BorderBrush="#D1D5DB"
                             Text="{Binding SearchInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Dátum intervallum"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>

                    <StackPanel Orientation="Horizontal">
                        <DatePicker Width="125"
                                    SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text=" - "
                                   VerticalAlignment="Center"
                                   Margin="5 0"/>

                        <DatePicker Width="125"
                                    SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0 0 0 15">
                    <TextBlock Text="Státusz"
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>

                    <ComboBox Height="36"
                              Padding="5"
                              Background="#F3F4F6"
                              BorderBrush="#D1D5DB"
                              ItemsSource="{Binding StatusList}"
                              SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Text"
                              SelectedValuePath="Code"/>
                </StackPanel>

                <Button Content="Keresés"
                        Height="44"
                        Cursor="Hand"
                        Command="{Binding CommandSearch}"
                        Style="{DynamicResource RoundedButtonStyle}"
                        Margin="0 20 0 0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Effect="{StaticResource CardShadow}">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 20 0 0">

                    <Button Content="Megtekintés"
                            Width="140"
                            Height="40"
                            Margin="5"
                            Command="{Binding CommandOpen}"
                            Style="{DynamicResource RoundedButtonStyle}"/>

                    <Button Content="Nyomtatás / PDF"
                            Width="150"
                            Height="40"
                            Margin="5"
                            Command="{Binding CommandPrint}"
                            Style="{DynamicResource RoundedButtonStyle}"/>

                    <Button Content="Sztornó"
                            Width="120"
                            Height="40"
                            Background="#DC2626"
                            Foreground="White"
                            Margin="5"
                            Command="{Binding CommandStorno}"
                            Style="{DynamicResource RoundedButtonStyle}"/>

                    <Button Content="🗑️ Törlés"
                            Width="120"
                            Height="40"
                            Background="#7F1D1D"
                            Foreground="White"
                            Margin="5"
                            Command="{Binding CommandDelete}"
                            Style="{DynamicResource RoundedButtonStyle}"
                            ToolTip="Végleges törlés (Csak Admin)"/>

                </StackPanel>

                <Border Background="#F9FAFB"
                        CornerRadius="10"
                        Padding="10">

                    <DataGrid ItemsSource="{Binding INVOICE_HEADERSList}"
                              SelectedItem="{Binding SelectedINVOICE_HEADERS}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E5E7EB">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Számlaszám"
                                                Binding="{Binding INVOICE_NUMBER}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Kelt"
                                                Binding="{Binding ISSUE_DATE, StringFormat=\{0:yyyy.MM.dd\}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Vevő"
                                                Binding="{Binding CLIENT_NAME}"
                                                Width="200"/>

                            <DataGridTextColumn Header="Státusz"
                                                Binding="{Binding SZLASTAT, Converter={StaticResource StatusToTextConverter}}"
                                                Width="160"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Border>

            </DockPanel>

        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" 
                Margin="0,15,0,0" 
                BorderBrush="#FF64CCf1" 
                BorderThickness="1" 
                CornerRadius="2">
            <Grid Background="AntiqueWhite">
                <Button Content="Kilép"
                        HorizontalAlignment="Right"
                        Height="25"
                        Margin="0,5,10,8"
                        Width="60"
                        Command="{Binding CommandQuitBase}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource RoundedButtonStyle}" />
            </Grid>
        </Border>

    </Grid>

</Window>