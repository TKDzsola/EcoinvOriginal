<Window x:Class="Ecoinv.Forms.SEARCHINVOICEFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ecoinv.Forms"
        xmlns:vm="clr-namespace:Ecoinv.DataContext"
        mc:Ignorable="d"
        x:Name="SearchWindow"
        Title="Számla keresése és Pénzügyi rendezés" Height="750" Width="1150" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:SEARCHINVOICEDataContext />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Components/RoundedButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Margin="15" Background="White" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Margin="20">
                <TextBlock Text="Keresési feltételek" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <Label Content="Ügyfél neve:"/>
                <TextBox Text="{Binding SearchClientName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="30" VerticalContentAlignment="Center"/>

                <Label Content="Számlastátusz:"/>
                <ComboBox ItemsSource="{Binding StatusList}" 
                          SelectedValue="{Binding SelectedStatus}" 
                          SelectedValuePath="Code" 
                          DisplayMemberPath="Text" 
                          Margin="0,0,0,10" Height="30"/>

                <Label Content="Dátum intervallum:"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <DatePicker SelectedDate="{Binding FromDate}"/>
                    <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}"/>
                </Grid>

                <CheckBox Content="Csak a kifizetetlenek" IsChecked="{Binding OnlyUnpaid}" Foreground="Red" FontWeight="Bold" Margin="0,10"/>

                <Button Content="KERESÉS" Command="{Binding CommandSearch}" Margin="0,15,0,0" Height="45" 
                        Background="#64CCf1" Foreground="White" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="0,15,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="10" Padding="10">
                <DataGrid ItemsSource="{Binding INVOICE_HEADERSList}" SelectedItem="{Binding SelectedINVOICE_HEADERS}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" 
                          Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Számlaszám" Binding="{Binding INVOICE_NUMBER}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Kelt" Binding="{Binding ISSUE_DATE, StringFormat={}{0:yyyy.MM.dd}}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Vevő" Binding="{Binding CLIENT_NAME}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Bruttó" Binding="{Binding TOTAL_GROSS, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Befizetve" Width="90" FontWeight="Bold" Foreground="Green">
                            <DataGridTextColumn.Binding>
                                <Binding Path="PAID_AMOUNT" StringFormat="{}{0:N2}" UpdateSourceTrigger="LostFocus"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Hátralék" Binding="{Binding DEBT_AMOUNT, StringFormat={}{0:N2}}" Width="90" IsReadOnly="True" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,15">
                <Button Content="Teljes befizetés" Command="{Binding CommandSetPaid}" Width="140" Height="40" Margin="5" 
                        Background="Goldenrod" Foreground="White" FontWeight="Bold"
                        Style="{StaticResource RoundedButtonStyle}"/>

                <Button Content="Nyomtatás / PDF" Command="{Binding CommandPrint}" Width="140" Height="40" Margin="5" 
                        Background="ForestGreen" Foreground="White"
                        Style="{StaticResource RoundedButtonStyle}"/>

                <Button Content="Sztornó" Command="{Binding CommandStorno}" Width="100" Height="40" Margin="5" 
                        Background="#E74C3C" Foreground="White"
                        Style="{StaticResource RoundedButtonStyle}"/>

                <Button Content="Törlés" Command="{Binding CommandDelete}" Width="100" Height="40" Margin="5" 
                        Background="#C0392B" Foreground="White" 
                        Style="{StaticResource RoundedButtonStyle}"/>
            </StackPanel>

            <Border Grid.Row="2" CornerRadius="10" Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFF0F0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalDebt}" Value="0">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Kintlévőség összesen: " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalDebt, StringFormat={}{0:N2} €}" FontSize="24" FontWeight="Bold" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalDebt}" Value="0">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Button Grid.Column="1" Content="Bezár" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Width="80" Margin="0,0,20,5" Height="30" Background="#64CCf1" Foreground="White"
                Command="{Binding CommandQuitBase}" 
                CommandParameter="{Binding ElementName=SearchWindow}" 
                Style="{StaticResource RoundedButtonStyle}"/>
    </Grid>
</Window>