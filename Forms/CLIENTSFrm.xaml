<Window x:Class="Ecoinv.Forms.CLIENTSFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Ecoinv.Forms.UserControlPages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ecoinv.Forms"
        xmlns:vm="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        mc:Ignorable="d"
        x:Name="ClientWindow"
        Title="Ügyféltörzs és Pénzügyi Státusz" Height="850" Width="1000" WindowStartupLocation="CenterScreen"
        Background="WhiteSmoke">

    <Window.DataContext>
        <vm:CLIENTSDataContext />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <components:IN2Bool x:Key="in2bool" />
            <components:NUllaEgy2Bool x:Key="n01bool" />
            <components:InvertBooleanConverter x:Key="InvertBool" />
            <components:FlexDecimalConverter x:Key="FlexDecimal" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#FF64CCf1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundedButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="#FF64CCf1" 
                                    BorderThickness="1" 
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#B3E5FC"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Background="AntiqueWhite">
            <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                <Label Content="Keresés (Név/Megj.):" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Width="200" Margin="10,0" Padding="5" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <CheckBox Content="Csak aktívak" IsChecked="{Binding IsActiveOnly}" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="Keresés" Command="{Binding CommandSearch}" 
                        Style="{StaticResource RoundedButtonStyle}"
                        Width="100" Height="30" Margin="20,0,0,0"
                        Background="#29B6F6" Foreground="White"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <DataGrid ItemsSource="{Binding ClientsList}" 
                          SelectedItem="{Binding SelectedClient}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          AlternatingRowBackground="BlanchedAlmond"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding NAME}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Város" Binding="{Binding CITY}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Aktív" Binding="{Binding CACTIVE, Converter={StaticResource in2bool}}" Width="40"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Background="AntiqueWhite" Margin="5,0,5,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
                    <Button Content="Új" Command="{Binding CommandNew}" Style="{StaticResource RoundedButtonStyle}" Width="80" Height="30" Margin="3" Background="#81C784"/>
                    <Button Content="Módosít" Command="{Binding CommandModify}" Style="{StaticResource RoundedButtonStyle}" Background="#FFF176" Foreground="Black" Width="80" Height="30" Margin="3"/>
                    <Button Content="Mentés" Command="{Binding CommandSave}" Style="{StaticResource RoundedButtonStyle}" Width="80" Height="30" Margin="3" Background="#4FC3F7" Foreground="White"/>

                    <Button Content="{Binding DeleteButtonText}" 
                            Command="{Binding CommandDelete}" 
                            Style="{StaticResource RoundedButtonStyle}" 
                            Width="80" Height="30" Margin="3" 
                            Background="#E57373" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">

                    <pages:ClientsDetailUCPage DataContext="{Binding CurrentClient}" 
                                               IsEnabled="{Binding DataContext.IsEditing, ElementName=ClientWindow}"
                                               Margin="0,0,0,5"/>

                    <pages:AdressesUCPage DataContext="{Binding CurrentAddress}" 
                                          IsEnabled="{Binding DataContext.IsEditing, ElementName=ClientWindow}"
                                          Margin="0,0,0,5"/>

                    <Border Style="{StaticResource CardBorderStyle}" Background="#FFFDE7" BorderBrush="Orange" BorderThickness="2">
                        <StackPanel Margin="10">
                            <Label Content="Pénzügyi státusz" FontWeight="Bold" FontSize="14" Foreground="#F57C00"/>
                            <Separator Background="Orange" Margin="0,5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <TextBlock Text="Aktuális tartozás összesen: " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                           Text="{Binding CustomerDebt, StringFormat={}{0:N2} €}"
                                           Foreground="Red"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Background="Transparent" BorderThickness="0">
                <Button Content="Ügyfél kiválasztása számlához" 
                        Command="{Binding CommandSelect}" 
                        CommandParameter="{Binding ElementName=ClientWindow}"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="#4CAF50" Foreground="Black" FontWeight="Bold"
                        Height="40" Margin="10"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="AntiqueWhite" BorderBrush="#FF64CCf1" BorderThickness="0,1,0,0">
            <Button Content="Bezár" Width="100" Height="35" Margin="0,0,15,0" HorizontalAlignment="Right"
                    Style="{StaticResource RoundedButtonStyle}" 
                    Command="{Binding CommandQuitBase}" CommandParameter="{Binding ElementName=ClientWindow}"/>
        </Border>
    </Grid>
</Window>