<Window x:Class="Ecoinv.Forms.VATRATESFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        mc:Ignorable="d"
        x:Name="DataFormName"
        Title="ÁFA Kulcsok" Height="400" Width="450">

    <Window.DataContext>
        <dataContext:VATRATESDataContext/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Components/RoundedButton.xaml" />
                <ResourceDictionary Source="../Components/ShadowLabel.xaml" />
                <ResourceDictionary Source="../Components/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" AlternatingRowBackground="BlanchedAlmond"
                  SelectedItem="{Binding SelectedVATRATES, Mode=TwoWay}"
                  ItemsSource="{Binding VATRATESList}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50" Header="ID" Binding="{Binding ID}"/>
                <DataGridTextColumn Width="*" Header="Megnevezés" Binding="{Binding NAME}" />
                <DataGridTextColumn Width="80" Header="Kulcs (%)" Binding="{Binding RATES}" />
                <DataGridCheckBoxColumn Width="50" Header="Aktív" Binding="{Binding IsActive}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Margin="5" BorderBrush="#FF64CCf1" BorderThickness="1" CornerRadius="2">
            <Grid Background="AntiqueWhite" IsEnabled="{Binding IsEditing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Név:" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding SelectedVATRATES.NAME}" MaxLength="15"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Érték (%):" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="3" Margin="2" Text="{Binding SelectedVATRATES.RATES}"/>

                <CheckBox Grid.Row="1" Grid.Column="0" Content="Aktív" Margin="5" 
                          IsChecked="{Binding SelectedVATRATES.IsActive}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5" Background="AntiqueWhite">
            <Button Content="Új" Command="{Binding CommandNew}" Width="70" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
            <Button Content="Módosít" Command="{Binding CommandModify}" Width="70" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
            <Button Content="Mentés" Command="{Binding CommandSave}" Width="70" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
            <Button Content="Töröl" Command="{Binding CommandDelete}" Width="70" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Bezár" HorizontalAlignment="Right" Width="70" Margin="10" 
                Style="{DynamicResource RoundedButtonStyle}" 
                Command="{Binding CommandQuitBase}" CommandParameter="{Binding ElementName=DataFormName}"/>
    </Grid>
</Window>