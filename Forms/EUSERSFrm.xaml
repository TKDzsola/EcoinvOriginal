<Window x:Class="Ecoinv.Forms.EUSERSFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        mc:Ignorable="d"
        x:Name="DataFormName"
        Title="Alkalmazott törzsadatok" Height="377" Width="452">

  <Window.DataContext>
    <dataContext:EUSERSDataContext/>
  </Window.DataContext>
  
  <Window.Resources>

    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Components/RoundedButton.xaml" />
        <ResourceDictionary Source="../Components/ShadowLabel.xaml" />
        <ResourceDictionary Source="../Components/Converters.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>

  </Window.Resources>

  <Grid>

    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="0*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="62" />
      <RowDefinition Height="50" />
    </Grid.RowDefinitions>


    <DataGrid Grid.Row="0"
              VerticalContentAlignment="Stretch"
              Margin="5,5,5,5"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              AlternatingRowBackground="BlanchedAlmond"
              IsEnabled="{Binding Path=IsGridBrowsing}"
              SelectedItem="{Binding Path=SelectedEUSERS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Path=EUSERSList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >


      <DataGrid.Columns>
        <DataGridTextColumn Width="50"  Header="ID"                   Binding="{Binding Path=ID}"/>
        <DataGridTextColumn Width="110" Header="Bejelentkezési név"   Binding="{Binding Path=UNAME}" />
        <DataGridTextColumn Width="*"   Header="Teljes név"           Binding="{Binding Path=FULNAME}" />
        <DataGridCheckBoxColumn Width="30" Header="Aktív" Binding="{Binding Path=UACTIVE, Converter={StaticResource in2bool}}"/>
      </DataGrid.Columns>

    </DataGrid>

    <Border Grid.Row="1" Margin="5,5,5,5" BorderBrush="#FF64CCf1" BorderThickness="1" CornerRadius="2">
      <Grid Background="AntiqueWhite" HorizontalAlignment="Stretch"
            IsEnabled="{Binding Path=IsEditing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <Grid.RowDefinitions>
          <RowDefinition Height="25" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="ID" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Top" />
        <Label Grid.Row="0" Content="Bejelentk." HorizontalAlignment="Left" Margin="55,0,0,0" VerticalAlignment="Top" />
        <Label Grid.Row="0" Content="Teljes név" HorizontalAlignment="Left" Margin="176,0,0,0" VerticalAlignment="Top" />
        <Label Grid.Row="0" Content="Jelszó" HorizontalAlignment="Right" Margin="0,0,82,0" VerticalAlignment="Top"/>
        <Label Grid.Row="0" Content="Akt." HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Top"/>
        <TextBox Grid.Row="1" HorizontalAlignment="Left" Height="19" Margin="7,0,0,6" 
                 TextWrapping="Wrap" Text="{Binding Path=SelectedEUSERS.ID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 Width="38" IsEnabled="False" />
        <TextBox Grid.Row="1" HorizontalAlignment="Left" Height="19" Margin="51,0,0,6" 
                 TextWrapping="Wrap" Text="{Binding Path=SelectedEUSERS.UNAME, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 Width="73" IsEnabled="{Binding Path=IsNewRecord}" MaxLength="15" />
        <TextBox Grid.Row="1" HorizontalAlignment="Stretch" Height="19" Margin="130,0,152,6" 
                 TextWrapping="Wrap" Text="{Binding Path=SelectedEUSERS.FULNAME, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 Width="auto" IsEnabled="{Binding Path=IsEditing}" MaxLength="30"/>

        <components:PasswordBox2 Grid.Row="1" HorizontalAlignment="Right" Height="19" Margin="0,0,55,6"
                Password="{Binding Path=SelectedEUSERS.JELSZO_NO_MD5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="87" IsEnabled="{Binding Path=IsEditing}" MaxLength="32" />

        <CheckBox Grid.Row="1" HorizontalAlignment="Right" Margin="0,2,21,6" Width="18" 
                  IsChecked="{Binding Path=SelectedEUSERS.UACTIVE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource in2bool}}" 
                  IsEnabled="{Binding Path=IsEditing}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="5,5,5,5" BorderBrush="#FF64CCf1" BorderThickness="1" CornerRadius="2">
      <Grid Background="AntiqueWhite">
        <Button Name="NewSaveBtn"
                Content="{Binding Path=ContentBtnNewSave}"
                HorizontalAlignment="Left"
                Height="25"
                Margin="5,5,0,8"
                Width="60"
                ToolTip="{Binding Path=ToolTipBtnNewSave}"
                Command="{Binding Path=CommandNewSave}"
                Style="{DynamicResource RoundedButtonStyle}" />
        <Button Name="ModifyCancelBtn"
                Content="{Binding ContentBtnModifyCancel}"
                HorizontalAlignment="Left"
                Height="25"
                Margin="72,5,0,8"
                Width="60"
                ToolTip="{Binding ToolTipBtnModifyCancel}"
                Command="{Binding CommandModifyCancel}"
                Style="{DynamicResource RoundedButtonStyle}" />
        <Button Name="DelBtn"
                Content="Töröl"
                HorizontalAlignment="Left"
                Height="25"
                Margin="139,5,0,8"
                Width="60"
                ToolTip="Kijelölt rekord törlése!"
                Command="{Binding Path=CommandDelete}"
                Style="{DynamicResource RoundedButtonStyle}" />
        <Button Name="QuitBtn"
                Content="Kilép"
                HorizontalAlignment="Right"
                Height="25"
                Margin="0,5,10,8"
                Width="60"
                Command="{Binding CommandQuitBase}" CommandParameter="{Binding ElementName=DataFormName}"
                Style="{DynamicResource RoundedButtonStyle}" />
      </Grid>
    </Border>

  </Grid>
</Window>
