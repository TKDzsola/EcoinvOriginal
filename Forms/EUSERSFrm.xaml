<Window x:Class="Ecoinv.Forms.EUSERSFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dataContext="clr-namespace:Ecoinv.DataContext"
        xmlns:components="clr-namespace:Ecoinv.Components"
        mc:Ignorable="d"
        x:Name="DataFormName"
        Title="Alkalmazott törzsadatok" Height="400" Width="500">

    <Window.DataContext>
        <dataContext:EUSERSDataContext/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Components/RoundedButton.xaml" />
                <ResourceDictionary Source="../Components/ShadowLabel.xaml" />
                <ResourceDictionary Source="../Components/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" AlternatingRowBackground="BlanchedAlmond"
                  SelectedItem="{Binding SelectedEUSERS, Mode=TwoWay}"
                  ItemsSource="{Binding EUSERSList}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50" Header="ID" Binding="{Binding ID}"/>
                <DataGridTextColumn Width="120" Header="Bej. Név" Binding="{Binding UNAME}" />
                <DataGridTextColumn Width="*" Header="Teljes Név" Binding="{Binding FULNAME}" />
                <DataGridCheckBoxColumn Width="50" Header="Admin" Binding="{Binding IsAdminUser}"/>
                <DataGridCheckBoxColumn Width="50" Header="Aktív" Binding="{Binding IsActive}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Margin="5" BorderBrush="#FF64CCf1" BorderThickness="1" CornerRadius="2">
            <Grid Background="AntiqueWhite" IsEnabled="{Binding IsEditing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Bej. Név:" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="2" Text="{Binding SelectedEUSERS.UNAME}" MaxLength="15"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Teljes Név:" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="3" Margin="2" Text="{Binding SelectedEUSERS.FULNAME}" MaxLength="30"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Jelszó:" Margin="5"/>
                <components:PasswordBox2 Grid.Row="1" Grid.Column="1" Margin="2" 
                                         Password="{Binding SelectedEUSERS.JELSZO_NO_MD5, Mode=TwoWay}"/>

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Admin" Margin="5" IsChecked="{Binding SelectedEUSERS.IsAdminUser}"/>
                    <CheckBox Content="Aktív" Margin="15,5,5,5" IsChecked="{Binding SelectedEUSERS.IsActive}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5" Background="AntiqueWhite">
            <Button Content="Új" Command="{Binding CommandNew}" Width="80" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
            <Button Content="Módosít" Command="{Binding CommandModify}" Width="80" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
            <Button Content="Mentés" Command="{Binding CommandSave}" Width="80" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
            <Button Content="Töröl" Command="{Binding CommandDelete}" Width="80" Margin="5" Style="{DynamicResource RoundedButtonStyle}"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Bezár" HorizontalAlignment="Right" Width="80" Margin="10" 
                Style="{DynamicResource RoundedButtonStyle}" 
                Command="{Binding CommandQuitBase}" CommandParameter="{Binding ElementName=DataFormName}"/>
    </Grid>
</Window>